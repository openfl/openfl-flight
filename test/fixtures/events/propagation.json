{
  "stopImmediateAtTarget": [
    "target-first"
  ],
  "stopPropagationCapture": [
    "root-first",
    "root-second",
    "parent-capture",
    "child-capture",
    "target"
  ],
  "stopImmediatePropagation": [
    "target",
    "child-first"
  ],
  "nonBubbling": [
    "target"
  ],
  "stopPropagation": [
    "target",
    "child-first",
    "child-second"
  ],
  "preventDefault": {
    "cancelable": {
      "dispatchResult": false,
      "isDefaultPrevented": true
    },
    "nonCancelable": {
      "dispatchResult": true,
      "isDefaultPrevented": null
    }
  },
  "route": [
    {
      "listener": "root-capture",
      "currentTarget": "root",
      "phase": 1,
      "target": "grandchild"
    },
    {
      "listener": "parent-capture",
      "currentTarget": "parent",
      "phase": 1,
      "target": "grandchild"
    },
    {
      "listener": "child-capture",
      "currentTarget": "child",
      "phase": 1,
      "target": "grandchild"
    },
    {
      "listener": "grandchild-target",
      "currentTarget": "grandchild",
      "phase": 2,
      "target": "grandchild"
    },
    {
      "listener": "child-bubble",
      "currentTarget": "child",
      "phase": 3,
      "target": "grandchild"
    },
    {
      "listener": "parent-bubble",
      "currentTarget": "parent",
      "phase": 3,
      "target": "grandchild"
    },
    {
      "listener": "root-bubble",
      "currentTarget": "root",
      "phase": 3,
      "target": "grandchild"
    }
  ]
}
